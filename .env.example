# MongoDB Configuration
MONGO_URL=mongodb://localhost:27017
DB_NAME=collabconnect

# JWT Authentication
JWT_SECRET=your-secret-key-here-change-in-production-min-256-bits

# OpenAI API (for AI-powered matching)
OPENAI_API_KEY=sk-your-openai-api-key

# Stripe Payment Processing
STRIPE_API_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Backend URL (used by frontend)
REACT_APP_BACKEND_URL=http://localhost:8001

# Email Configuration (for future features)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@collabconnect.com

# Redis Cache (optional - for future caching layer)
REDIS_URL=redis://localhost:6379

# Environment
NODE_ENV=development
PYTHON_ENV=development
